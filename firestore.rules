rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify SmartServe Super Administrator custom claim
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.superadmin == true ||
        request.auth.token.admin == true
      );
    }

    // Subscriptions collection:
    // Anyone (customers, restaurant owners) can read subscription status to verify validity
    // ONLY SmartServe Super Admin with trusted custom claim can create, update, or renew
    match /subscriptions/{restaurantId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Subscription audit logs: Super Admin only
    match /subscription_audit_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Settings (cafe info, hours, contacts)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Menu items & categories
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /menuOffers/{offerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Customer reviews (public can submit, authenticated admins can moderate)
    match /customerReviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Sales & expenses: authenticated admins only
    match /sales/{saleId} {
      allow read, write: if isAuthenticated();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

